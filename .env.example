# --- Supabase Postgres -----------------------------------------------------
# From the Supabase dashboard: Project Settings > Database > Connection string.
#
# DATABASE_URL  = "Transaction pooler" (port 6543). Used by the Next app at
#                 runtime; safe for serverless.
# DIRECT_URL    = "Direct connection" (port 5432). Used by db:migrate / db:seed,
#                 which run multi-statement transactions the pooler rejects.
DATABASE_URL=
DIRECT_URL=

# For a plain local Postgres instead, set just DATABASE_URL, e.g.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/wedding

# --- Auth ----------------------------------------------------------------
# Signs the guest session cookie issued after the last-4-digits name claim.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Backoffice admin login (single account, no admin_users table).
# Store a bcrypt hash, not the plaintext. Generate with:
#   node -e "import('bcryptjs').then(b => console.log(b.hashSync(process.argv[1], 10)))" 'your-password'
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# --- Storage -----------------------------------------------------------
# Supabase Storage bucket for guest photo/video proof on the wall.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WALL_BUCKET=wall-media

NEXT_PUBLIC_APP_URL=http://localhost:3000
